# ---------------------------------------------------------------------------
# MEMORA configuration. Copy to .env (never commit .env).
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (Atlas UI > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=memora
# mongodb = $vectorSearch on Atlas (or the mongodb-atlas-local image). Use this for the demo.
# local   = in-process cosine similarity. DEVELOPMENT/TEST FALLBACK ONLY, not Atlas Vector Search.
VECTOR_BACKEND=mongodb

# LLM provider: anthropic | openai | mock (mock = offline fallback, no real answers)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
EXTRACTOR_MODEL=claude-haiku-5-5
# For OpenAI (or an OpenAI-compatible endpoint):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=<your chat model>
# EXTRACTOR_MODEL=<a fast, cheap model>

# Embeddings: voyage | openai | hash (hash = offline fallback, lexical only)
# EMBEDDING_DIMENSIONS must match the model output AND the Vector Search index (numDimensions).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024
# OpenAI alternative:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=change-me
ALLOW_SIGNUP=true

# Demo tools (seeded demo account, per-user clock for showing expiry/decay, demo reset)
ENABLE_DEMO_TOOLS=true
DEMO_USERNAME=demo
DEMO_PASSWORD=memora-demo

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Retention and deletion policy
TTL_GRACE_SECONDS=3600
MESSAGE_RETENTION_DAYS=0
EPISODE_RETENTION_DAYS=30
FORGET_REDACTS_EVIDENCE=true

# Optional tuning (defaults shown) - see backend/app/core/config.py for all options
# W_SIMILARITY=0.40
# W_IMPORTANCE=0.15
# W_CONFIDENCE=0.10
# W_STRENGTH=0.15
# W_TYPE=0.05
# W_GRAPH=0.10
# W_SCOPE=0.05
# BUDGET_CORE=220
# BUDGET_MEMORIES=600
# BUDGET_RECENT_TURNS=700
# BUDGET_EVIDENCE=300
